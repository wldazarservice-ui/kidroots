rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Limite fixee par le serveur selon la formule (famille 5, enseignant 35, ecole 300), 5 par defaut
    function limitOf(userId, field) {
      return get(/databases/$(database)/documents/users/$(userId)).data.get(field, 5);
    }
    // Emplacement numerote (c1, c2… / d1, d2…) dans la limite du compte
    function slotOk(id, prefix, userId, field) {
      return id.matches(prefix + '[1-9][0-9]{0,2}') && int(id.split(prefix)[1]) <= limitOf(userId, field);
    }

    // Champs reserves au serveur (paiement Stripe) : jamais modifiables par l'app
    function touchesPremium(data) {
      return data.keys().hasAny(['premium', 'premiumAt', 'stripeSessionId', 'comp', 'subscriptionId', 'subStatus', 'plan', 'premiumUntil', 'cancelAtPeriodEnd', 'stripeCustomerId', 'refCode', 'refCredits', 'refCount', 'referredBy', 'trialUsed', 'tier', 'maxChildren', 'maxDevices', 'school', 'deviceSwaps', 'giftUntil']);
    }

    // Doc parent : seul son proprietaire peut lire/ecrire, sauf les champs premium.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && !touchesPremium(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['premium', 'premiumAt', 'stripeSessionId', 'comp', 'subscriptionId', 'subStatus', 'plan', 'premiumUntil', 'cancelAtPeriodEnd', 'stripeCustomerId', 'refCode', 'refCredits', 'refCount', 'referredBy', 'trialUsed', 'tier', 'maxChildren', 'maxDevices', 'school', 'deviceSwaps', 'giftUntil']);

      // Profils enfants / eleves : emplacements c1..cN (N = maxChildren du compte, 5 par defaut)
      match /children/{childId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
                      && slotOk(childId, 'c', userId, 'maxChildren');
      }

      // Appareils : emplacements d1..dN (N = maxDevices du compte, 5 par defaut)
      // Retrait uniquement par le serveur (/api/remove-device, 3 remplacements par mois)
      match /devices/{slot} {
        allow read, update: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
                      && slotOk(slot, 'd', userId, 'maxDevices');
      }
    }
  }
}
