rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Champs reserves au serveur (paiement Stripe) : jamais modifiables par l'app
    function touchesPremium(data) {
      return data.keys().hasAny(['premium', 'premiumAt', 'stripeSessionId']);
    }

    // Doc parent : seul son proprietaire peut lire/ecrire, sauf les champs premium.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && !touchesPremium(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['premium', 'premiumAt', 'stripeSessionId']);

      // Sous-collection des profils enfants
      match /children/{childId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }
  }
}
