rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Champs reserves au serveur (paiement Stripe) : jamais modifiables par l'app
    function touchesPremium(data) {
      return data.keys().hasAny(['premium', 'premiumAt', 'stripeSessionId', 'comp', 'subscriptionId', 'subStatus', 'plan', 'premiumUntil', 'cancelAtPeriodEnd', 'stripeCustomerId', 'refCode', 'refCredits', 'refCount', 'referredBy', 'trialUsed']);
    }

    // Doc parent : seul son proprietaire peut lire/ecrire, sauf les champs premium.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && !touchesPremium(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['premium', 'premiumAt', 'stripeSessionId', 'comp', 'subscriptionId', 'subStatus', 'plan', 'premiumUntil', 'cancelAtPeriodEnd', 'stripeCustomerId', 'refCode', 'refCredits', 'refCount', 'referredBy', 'trialUsed']);

      // Profils enfants : 5 maximum (emplacements c1..c5 pour les nouveaux profils)
      match /children/{childId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
                      && childId in ['c1', 'c2', 'c3', 'c4', 'c5'];
      }

      // Appareils : 5 maximum (emplacements d1..d5)
      match /devices/{slot} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
                      && slot in ['d1', 'd2', 'd3', 'd4', 'd5'];
      }
    }
  }
}
